---
const { title, description, class: classList = "" } = Astro.props;
---

<div
  class={`rounded-xl bg-brand-50/5 backdrop-blur-sm border border-brand-50/10 p-6 space-y-3 transition-all duration-300 hover:bg-brand-50/10 hover:border-brand-50/20 ${classList}`}>
  <h3 class="font-heading text-brand-50 text-lg">
    {title}
  </h3>

  <p class="text-brand-50/70 leading-relaxed">
    {description}
  </p>
</div>
