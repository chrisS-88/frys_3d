---
import { navLinks } from "../data/navLinks.js";
import NavLink from "./NavLink.astro";
---

<header class="py-6">
  <nav
    class="fixed top-6 left-1/2 -translate-x-1/2
          w-[calc(100%-3rem)] max-w-xl
          h-20 flex justify-between items-center px-6
          tracking-wide uppercase z-50
          bg-brand-900/10 backdrop-blur-xl
          rounded-xl shadow-xl border border-brand-50/10
          transition-transform duration-300">
    <a href="/" class="font-heading text-xl font-semibold tracking-widest text-brand-50"> Fry_3D </a>

    <!-- decktop menu -->
    <ul class="hidden lg:flex gap-5">
      {
        navLinks.map((link) => {
          return (
            <li>
              <NavLink href={link.href} label={link.label} />
            </li>
          );
        })
      }
    </ul>

    <!-- Mobile Button -->
    <button id="menu-btn" class="lg:hidden burger-3d">
      <div class="inner">
        <div class="face front">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="face back">
          <span></span>
          <span></span>
        </div>
      </div>
    </button>
  </nav>

  <!-- Mobile Sidebar -->
  <div
    id="mobile-menu"
    class="fixed left-1/2 -translate-x-1/2 top-28
          w-[calc(100%-3rem)]
          bg-brand-900/10 backdrop-blur-xl
          rounded-xl border border-brand-50/10
          overflow-hidden shadow-xl
          opacity-0
          transition-all duration-500 ease-out pointer-events-none">
    <ul class="flex flex-col justify-center gap-6 text-2xl px-4 py-24">
      {
        navLinks.map((link, i) => {
          return (
            <li>
              <NavLink href={link.href} label={link.label} />
            </li>
          );
        })
      }
    </ul>
  </div>

  <style>
    .burger-3d {
      width: 32px;
      height: 32px;
      position: relative;
      perspective: 600px;
      cursor: pointer;
    }

    .burger-3d .inner {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    }

    .burger-3d .face {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .burger-3d .front span {
      width: 24px;
      height: 3px;
      background: white;
      margin: 3px 0;
      border-radius: 2px;
    }

    .burger-3d .back {
      transform: rotateY(180deg);
    }

    .burger-3d .back span {
      position: absolute;
      width: 24px;
      height: 3px;
      background: white;
      border-radius: 2px;
    }

    .burger-3d .back span:nth-child(1) {
      transform: rotate(45deg);
    }

    .burger-3d .back span:nth-child(2) {
      transform: rotate(-45deg);
    }

    #menu-btn.open .inner {
      transform: rotateY(180deg);
    }
  </style>

