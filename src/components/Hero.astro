---
import Button from "./Button.astro";
import GraphBg from "./svgs/Graph_bg.astro";
---

<section class="relative min-h-screen flex items-end bg-brand-900/90">
  <div class="absolute inset-0 overflow-hidden">
    <GraphBg class="text-brand-50/5 h-full object-cover z-0" />
  </div>

  <div class="relative max-w-lg px-6 mx-auto z-10">
    <h1 class="text-5xl lg:text-7xl font-semibold font-heading">
      3D Prints Made Local. <span class="block text-primary">Made Personal.</span>
    </h1>
    <p class="max-w-sm mt-4 text-lg">
      From custom parts to fun little gadgets — everything’s printed right here at home, with care, curiosity, and a love for making cool
      stuff.
    </p>
    <div class="my-20">
      <Button href="/contact" variant="primary" label="Got an idea? Let’s print it." />
    </div>
  </div>
</section>
