---
const { variant = "primary", href, class: className = "", label } = Astro.props;

const base = "inline-flex items-center justify-center px-5 py-3 rounded-md font-semibold transition-all duration-200";

const variants = {
  primary: "bg-primary text-brand-900 hover:bg-primary/80 shadow-[0_0_20px_rgb(1,245,255)] hover:shadow-[0_0_30px_rgba(1,245,255,0.6)]",
  secondary: "bg-white/5 text-brand-50/80 border border-secondary backdrop-blur-sm hover:bg-white/10 hover:text-white",
};
---

<a href={href} class={`${base} ${variants[variant as keyof typeof variants]} ${className}`}>
  {label}
</a>
