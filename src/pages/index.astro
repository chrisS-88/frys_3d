---
import Button from "../components/Button.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import GraphBg from "../components/svgs/Graph_bg.astro";
---

<BaseLayout>
  <section class="">
    <Hero />

    <div
      data-parallax
      data-parallax-speed="2"
      data-parallax-base="translate(-50%, -50%)"
      class="absolute top-full left-2/3 pointer-events-none w-[150vw] lg:w-[90vw]">
      <img src="/3d_lattice.webp" class="w-full opacity-40 saturate-0 animate-float z-0" />
    </div>
  </section>

  <section class="relative py-24 bg-brand-900 border-t-2 border-b-2 border-secondary">
    <div class="max-w-lg px-6 mx-auto space-y-4">
      <h2 class="text-4xl font-heading text-primary tracking-wide">A little side‑gig with a lot of passion</h2>

      <div class="max-w-md space-y-2">
        <p class="text-brand-50/80 leading-relaxed">
          Hey, I’m Billy — I run a small 3D‑printing setup from home. Nothing corporate, nothing over‑engineered. Just a hobby that got a
          bit out of hand.
        </p>

        <p class="text-brand-50/80 leading-relaxed">
          I print the things I love, the things people need, and the ideas people bring to me. If you want something unique, useful, or just
          plain cool, I’m your guy.
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 bg-brand-900/90">
    <div class="max-w-lg px-6 mx-auto space-y-8">
      <h2 class="text-4xl font-heading text-primary tracking-wide">Why choose a local maker</h2>

      <div class="grid gap-6 md:grid-cols-2">
        <FeatureCard
          title="Personal Service"
          description="You’re not dealing with a big shop. It’s just me — friendly, flexible, and happy to help."
        />

        <FeatureCard title="Quick Turnaround" description="If the printer’s free, your job gets done fast." />

        <FeatureCard title="Affordable" description="No big markups. Just fair prices for materials, time, and a bit of hobby joy." />

        <FeatureCard
          title="Made Nearby"
          description="Everything’s printed right here in West Yorkshire — no long waits, no overseas shipping."
        />
      </div>
    </div>
  </section>

  <section class="py-24 bg-brand-900/90">
    <div class="max-w-sm px-6 text-center mx-auto space-y-6">
      <h2 class="text-4xl font-heading text-primary tracking-wide">Want something printed?</h2>

      <p class="text-white/75 leading-relaxed">
        Drop me a message with what you’re thinking — a link, a photo, or even a rough idea is enough to get started.
      </p>

      <p class="text-white/75 leading-relaxed">Let’s make something cool.</p>

      <div class="my-12">
        <Button href="/contact" variant="secondary" label="Got an idea? Let’s print it." />
      </div>
    </div>
  </section>
</BaseLayout>
