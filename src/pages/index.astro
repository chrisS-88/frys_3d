---
import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section>
    <Hero />
  </section>

  <section class="py-24">
    <div class="max-w-lg px-6 mx-auto space-y-4">
      <!-- <div class="w-full max-w-sm h-3 bg-white/10 rounded-full overflow-hidden">
        <div class="h-full w-[70%] bg-gradient-to-r from-secondary/20 to-secondary rounded-full blink"></div>
      </div> -->

      <h2 class="text-4xl font-heading text-primary tracking-wide">A little side‑gig with a lot of passion</h2>

      <div class="max-w-md space-y-2">
        <p class="text-brand-50/80 leading-relaxed">
          Hey, I’m Billy — I run a small 3D‑printing setup from home. Nothing corporate, nothing over‑engineered. Just a hobby that got a
          bit out of hand.
        </p>

        <p class="text-brand-50/80 leading-relaxed">
          I print the things I love, the things people need, and the ideas people bring to me. If you want something unique, useful, or just
          plain cool, I’m your guy.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-lg px-6 mx-auto space-y-8">
      <h2 class="text-4xl font-heading text-primary tracking-wide">Why choose a local maker</h2>

      <div class="space-y-6">
        <div>
          <h3 class="font-display text-white text-lg">Personal Service</h3>
          <p class="text-white/70 leading-relaxed">
            You’re not dealing with a big shop. It’s just me — friendly, flexible, and happy to help.
          </p>
        </div>

        <div>
          <h3 class="font-display text-white text-lg">Quick Turnaround</h3>
          <p class="text-white/70 leading-relaxed">If the printer’s free, your job gets done fast.</p>
        </div>

        <div>
          <h3 class="font-display text-white text-lg">Affordable</h3>
          <p class="text-white/70 leading-relaxed">No big markups. Just fair prices for materials, time, and a bit of hobby joy.</p>
        </div>

        <div>
          <h3 class="font-display text-white text-lg">Made Nearby</h3>
          <p class="text-white/70 leading-relaxed">
            Everything’s printed right here in West Yorkshire — no long waits, no overseas shipping.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-sm px-6 text-center mx-auto space-y-6">
      <h2 class="text-4xl font-heading text-primary tracking-wide">Want something printed?</h2>

      <p class="text-white/75 leading-relaxed">
        Drop me a message with what you’re thinking — a link, a photo, or even a rough idea is enough to get started.
      </p>

      <p class="text-white/75 leading-relaxed">Let’s make something cool.</p>

      <div class="my-12">
        <Button href="/contact" variant="secondary" label="Got an idea? Let’s print it." />
      </div>
    </div>
  </section>
</BaseLayout>
